[Unit]
Description=DVSwitch Mode Switcher web interface
Wants=network-online.target
After=network-online.target analog_bridge.service mmdvm_bridge.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=asl
Group=asl
WorkingDirectory=/opt/dvswitch_mode_switcher
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -r /opt/dvswitch_mode_switcher/configs/config.yml
ExecStartPre=/usr/bin/test -r /opt/dvswitch_mode_switcher/configs/tg_alias.yml
ExecStart=/usr/bin/node /opt/dvswitch_mode_switcher/index.js -c /opt/dvswitch_mode_switcher/configs/config.yml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
